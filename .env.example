# Salin menjadi .env (install.bat melakukannya otomatis bila belum ada).
# Semua pengaturan berawalan ASF_. Default hanya bisa diakses dari komputer ini.
ASF_HOST=127.0.0.1
ASF_PORT=8000
# Akses LAN bersifat opsional. Untuk mengaktifkannya, ubah host dan tambahkan
# origin persis yang dipakai perangkat lain (ganti alamat dengan IP LAN komputer ini).
# ASF_HOST=0.0.0.0
# ASF_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://192.168.1.10:8000
ASF_OLLAMA_URL=http://127.0.0.1:11434
ASF_OLLAMA_MODEL=qwen2.5:7b-instruct
ASF_WHISPER_MODEL=large-v3-turbo
ASF_MAX_UPLOAD_MB=16384
